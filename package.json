    "stall-demo": "tsx scripts/stall-demo.ts",
    "demo": "tsx scripts/demo.ts",
    "asm": "tsx scripts/asm.ts",
    "programs": "tsx scripts/programs-bundle.ts",
    "weeks": "tsx scripts/make-week-branches.ts",
